config_version=5

[application]
config/name="Mark & Bark: The Big Idea"
config/version="3.7.0 Character 2.0"
run/main_scene="res://scenes/adventures.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Expressive 3D Mark and Bark in the complete painted campus story and three giant climbs, with original painting styles and a character performance studio."

[autoload]
Progress="*res://scripts/progress.gd"
Art="*res://scripts/art.gd"
Mega="*res://scripts/mega_state.gd"
Adventures="*res://scripts/adventure_navigation.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.10, 0.17, 0.23, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false

[audio]
driver/enable_input=false
