config_version=5

[application]
config/name="Mark & Bark: The Big Idea"
config/version="Fundate"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="The Fundate: a shrinking-ray story, leafy double jumps, giant books and playful campus skyways."

[autoload]
Progress="*res://scripts/progress.gd"
Art="*res://scripts/art.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.10, 0.17, 0.23, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false

[audio]
driver/enable_input=false
